{
  "name": "rbpan-client",
  "version": "1.0.0",
  "description": "rbpan client - static site generator with Pug + Stylus + Vue.js",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "start": "node build.js && npx serve dist -p 3000",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.1",
    "marked": "^18.0.11",
    "pug": "^3.0.3",
    "stylus": "^0.63.0",
    "vue": "^3.5.0"
  },
  "keywords": [
    "cloud-drive",
    "static-site",
    "pug",
    "stylus",
    "vue"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
