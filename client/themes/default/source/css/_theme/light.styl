:root {
  --accent: #6366f1;
  --accent-via: #8b5cf6;
  --accent-soft: rgba(99,102,241,0.08);
  --accent-hover: #4f46e5;
  --accent-glow: rgba(99,102,241,0.25);
  --bg: #f0f2f5;
  --surface: rgba(255,255,255,0.72);
  --surface-strong: rgba(255,255,255,0.88);
  --surface-weak: rgba(241,245,249,0.6);
  --surface-hover: rgba(255,255,255,0.85);
  --text: #1a1a2e;
  --text-secondary: #5a6078;
  --text-muted: #8b90a5;
  --border: rgba(200,205,220,0.5);
  --border-rgb: 200, 205, 220;
  --border-strong: rgba(180,185,200,0.7);
  --shadow-sm: 0 2px 8px rgba(0,0,0,0.04);
  --shadow: 0 4px 16px rgba(0,0,0,0.06), 0 1px 4px rgba(0,0,0,0.04);
  --shadow-md: 0 8px 32px rgba(0,0,0,0.08), 0 2px 8px rgba(0,0,0,0.04);
  --shadow-lg: 0 16px 48px rgba(0,0,0,0.12), 0 4px 16px rgba(0,0,0,0.06);
  --folder: #f59e0b;
  --folder-bg: rgba(245,158,11,0.1);
  --folder-hover-bg: rgba(245,158,11,0.16);
  --file-bg: rgba(241,245,249,0.5);
  --file-hover: rgba(248,250,252,0.7);
  --folder-hover: rgba(99,102,241,0.06);
  --progress-bg: rgba(226,232,240,0.5);
  --radius: 14px;
  --radius-sm: 8px;
  --radius-lg: 18px;
  --radius-xl: 24px;
  --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --glass-blur: 20px;
  --glass-saturate: 180%;

  /* Header bar variables (default: glassmorphism) */
  --bar-bg: rgba(255,255,255,0.55);
  --bar-blur: 20px;
  --bar-item-bg: rgba(255,255,255,0.5);
  --bar-item-border: rgba(200,205,220,0.4);
  --bar-item-hover: rgba(255,255,255,0.8);
  --bar-text: #1a1a2e;
  --bar-text-sub: #5a6078;
  --bar-border: 1px solid rgba(200,205,220,0.3);

  /* Language button variables (adaptive) */
  --lang-btn-size: 2.375rem;
  --lang-btn-font-size: 0.875rem;
  --lang-btn-font-weight: 400;
  --lang-dropdown-min-width: 11.25rem;
  --lang-item-padding: 0.6875rem 1rem;

  /* Page loader variables */
  --loader-bg: var(--bg);
  --loader-content-bg: var(--accent);
  --loader-logo-bg: rgba(99,102,241,0.15);
  --loader-logo-color: var(--accent);
  --loader-title-color: var(--text);
  --loader-bar-bg: rgba(99,102,241,0.15);
  --loader-bar-fill: var(--accent);
  --loader-text-color: var(--text-secondary);
}

/* Preset: 高斯模糊 (Gaussian Blur) */
[data-preset="gaussian"] {
  --surface: rgba(255,255,255,0.55);
  --surface-strong: rgba(255,255,255,0.75);
  --surface-weak: rgba(241,245,249,0.4);
  --surface-hover: rgba(255,255,255,0.7);
  --glass-blur: 40px;
  --bar-bg: rgba(255,255,255,0.35);
  --bar-blur: 40px;
  --bar-item-bg: rgba(255,255,255,0.35);
  --bar-item-border: rgba(200,205,220,0.3);
  --bar-item-hover: rgba(255,255,255,0.65);
  --shadow-sm: 0 2px 12px rgba(0,0,0,0.03);
  --shadow: 0 4px 20px rgba(0,0,0,0.04), 0 1px 4px rgba(0,0,0,0.02);
  --shadow-md: 0 8px 40px rgba(0,0,0,0.06), 0 2px 8px rgba(0,0,0,0.02);
  --shadow-lg: 0 16px 56px rgba(0,0,0,0.08), 0 4px 16px rgba(0,0,0,0.04);
}

/* Preset: 液态玻璃 (Liquid Glass) */
[data-preset="liquid"] {
  --surface: rgba(255,255,255,0.68);
  --surface-strong: rgba(255,255,255,0.85);
  --surface-weak: rgba(241,245,249,0.55);
  --surface-hover: rgba(255,255,255,0.82);
  --glass-blur: 24px;
  --glass-saturate: 200%;
  --bar-bg: rgba(255,255,255,0.5);
  --bar-blur: 24px;
  --bar-item-bg: rgba(255,255,255,0.45);
  --bar-item-border: rgba(180,185,200,0.35);
  --bar-item-hover: rgba(255,255,255,0.75);
  --border: rgba(180,185,200,0.4);
  --border-strong: rgba(160,165,180,0.6);
  --radius: 18px;
  --radius-sm: 10px;
  --radius-lg: 22px;
  --radius-xl: 28px;
  --shadow-sm: 0 4px 12px rgba(0,0,0,0.04);
  --shadow: 0 8px 24px rgba(0,0,0,0.06), 0 2px 8px rgba(0,0,0,0.03);
  --shadow-md: 0 12px 40px rgba(0,0,0,0.08), 0 4px 12px rgba(0,0,0,0.04);
  --shadow-lg: 0 20px 56px rgba(0,0,0,0.12), 0 6px 20px rgba(0,0,0,0.06);
}

/* Preset: 不透明圆角 (Opaque Rounded) */
[data-preset="opaque"] {
  --surface: rgba(255,255,255,0.95);
  --surface-strong: rgba(255,255,255,1);
  --surface-weak: rgba(241,245,249,0.9);
  --surface-hover: rgba(255,255,255,0.98);
  --glass-blur: 0px;
  --bar-bg: rgba(255,255,255,0.95);
  --bar-blur: 0px;
  --bar-item-bg: rgba(241,245,249,0.8);
  --bar-item-border: rgba(200,205,220,0.5);
  --bar-item-hover: rgba(241,245,249,0.95);
  --border: rgba(200,205,220,0.6);
  --border-strong: rgba(180,185,200,0.8);
  --radius: 16px;
  --radius-sm: 10px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --shadow-sm: 0 2px 8px rgba(0,0,0,0.06);
  --shadow: 0 4px 16px rgba(0,0,0,0.08), 0 1px 4px rgba(0,0,0,0.04);
  --shadow-md: 0 8px 24px rgba(0,0,0,0.1), 0 2px 8px rgba(0,0,0,0.06);
  --shadow-lg: 0 16px 40px rgba(0,0,0,0.14), 0 4px 16px rgba(0,0,0,0.08);
  --bar-border: 1px solid rgba(200,205,220,0.5);
}

/* Preset: 纯色方角 (Solid Square) */
[data-preset="solid"] {
  --surface: rgba(255,255,255,1);
  --surface-strong: rgba(255,255,255,1);
  --surface-weak: rgba(241,245,249,1);
  --surface-hover: rgba(255,255,255,1);
  --glass-blur: 0px;
  --bar-bg: rgba(255,255,255,1);
  --bar-blur: 0px;
  --bar-item-bg: rgba(241,245,249,0.8);
  --bar-item-border: rgba(200,205,220,0.6);
  --bar-item-hover: rgba(241,245,249,1);
  --border: rgba(200,205,220,0.7);
  --border-strong: rgba(180,185,200,0.9);
  --radius: 4px;
  --radius-sm: 4px;
  --radius-lg: 4px;
  --radius-xl: 4px;
  --shadow-sm: 0 1px 4px rgba(0,0,0,0.08);
  --shadow: 0 2px 8px rgba(0,0,0,0.1), 0 1px 2px rgba(0,0,0,0.06);
  --shadow-md: 0 4px 12px rgba(0,0,0,0.12), 0 2px 4px rgba(0,0,0,0.08);
  --shadow-lg: 0 8px 24px rgba(0,0,0,0.16), 0 4px 8px rgba(0,0,0,0.1);
  --bar-border: 1px solid rgba(200,205,220,0.7);
}